# Repo-wide editor defaults. Kotlin formatting is owned by ktlint
# (build-logic/ktlint-conventions) and the frontend keeps its own
# services/frontend/.editorconfig for JS/TS/Vue, so this file only sets
# universal hygiene plus indentation for the misc file types nothing
# else governs.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Markdown uses two trailing spaces as a hard line break.
[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.{json,json5}]
indent_style = space
indent_size = 2

[*.sh]
indent_style = space
indent_size = 2

[*.{tf,nix}]
indent_style = space
indent_size = 2

# Windows launcher must keep CRLF to run under cmd.exe.
[*.bat]
end_of_line = crlf

# Flyway finds a Java-based migration by its class name, so V16__Migrate_Signatures
# is the name the tool requires rather than a style choice.
[services/api/src/main/kotlin/db/migration/*.kt]
ktlint_standard_class-naming = disabled

# ArchUnit's @ArchTest is a test annotation ktlint does not recognise, so the
# backticked sentence names those rules are written with read as ordinary functions.
[services/api/src/test/kotlin/**.kt]
ktlint_function_naming_ignore_when_annotated_with = ArchTest

# These entry names are the wire values the generated OpenAPI client and the stored
# job rows already carry; upper-casing them would change the contract, not the style.
[services/api/src/main/kotlin/net/blueshell/api/shared/enums/JobExecutionCategory.kt]
ktlint_standard_enum-entry-name-case = disabled
