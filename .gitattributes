# Normalise line endings in the repo to LF; let Git decide what is text.
* text=auto eol=lf

# Platform-specific line endings.
*.bat   text eol=crlf
gradlew text eol=lf

# Binary assets — never diff or EOL-normalise these.
*.jar    binary
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.webp   binary
*.woff   binary
*.woff2  binary
*.ttf    binary
*.eot    binary
*.gz     binary
*.zip    binary
*.svg    -text

# Generated code — collapse in diffs and exclude from language stats so
# the repo's reported makeup and code-quality signal reflect what is
# actually hand-written. The OpenAPI clients are regenerated by
# scripts/generate-openapi-local.sh.
services/frontend/src/services/api/blueshell/** linguist-generated=true
services/frontend/src/services/api/discord/**   linguist-generated=true
*.gen.ts                                         linguist-generated=true
services/api/openapi.yaml                        linguist-generated=true

# Yarn PnP runtime + lockfiles are tooling output, not source.
services/frontend/.pnp.cjs        linguist-generated=true
services/frontend/.pnp.loader.mjs linguist-generated=true
services/frontend/yarn.lock       linguist-generated=true
services/frontend/.yarn/**        linguist-vendored=true

# Help Linguist classify the JVM sources correctly.
*.kts linguist-language=Kotlin
