// Taxonomy for the PR diff breakdown rendered by .github/scripts/pr_diff_stats.py.
//
// Each rule is [glob, service, category]. Rules are ORDERED and the first
// match wins, so put narrow rules above broad ones. Adding a service or a
// test type is one new entry.
//
// Glob syntax: `*` matches within a path segment, `**` spans segments,
// a trailing `/**` also matches the directory itself. Paths are
// repo-relative and always the NEW path for a rename.
//
// Categories drive the rollups at the bottom of the block:
//   prod                                    -> "production"
//   unit, integration, e2e, system, fixtures -> "tests"
//   generated                               -> excluded from every total
//   build, infra, docs, other               -> counted in the total only
[
  ["services/frontend/src/services/api/**", "frontend", "generated"],
  ["services/frontend/**/*.gen.ts", "frontend", "generated"],
  ["services/frontend/yarn.lock", "frontend", "generated"],
  ["services/frontend/.pnp.cjs", "frontend", "generated"],
  ["services/frontend/.pnp.loader.mjs", "frontend", "generated"],
  ["services/frontend/.yarn/**", "frontend", "generated"],
  ["services/api/openapi.json", "api", "generated"],
  ["**/gradle.lockfile", "api", "generated"],
  ["libs/openapi-specs/**", "libs", "generated"],

  ["services/api/src/integrationTest/**", "api", "integration"],
  ["services/api/src/testFixtures/**", "api", "fixtures"],
  ["services/api/src/test/**", "api", "unit"],
  ["services/api/src/main/**", "api", "prod"],
  ["services/api/clients/**", "api", "prod"],
  ["services/api/**", "api", "build"],

  ["services/frontend/tests/e2e/**", "frontend", "e2e"],
  ["services/frontend/tests/**", "frontend", "unit"],
  ["services/frontend/src/**", "frontend", "prod"],
  ["services/frontend/public/**", "frontend", "prod"],
  ["services/frontend/**", "frontend", "build"],

  ["services/system-tests/**", "system-tests", "system"],

  ["libs/**", "libs", "prod"],

  ["platform/**", "platform", "infra"],
  ["infra/**", "platform", "infra"],
  ["services/stalwart/**", "platform", "infra"],
  ["services/vault/**", "platform", "infra"],
  ["docker-compose*.yml", "platform", "infra"],

  ["build-logic/**", "ci", "build"],
  [".github/**", "ci", "build"],
  ["scripts/**", "ci", "build"],
  ["gradle/**", "ci", "build"],
  ["gradlew*", "ci", "build"],
  ["*.gradle.kts", "ci", "build"],

  ["docs/**", "docs", "docs"],
  ["specs/**", "docs", "docs"],
  ["**/*.md", "docs", "docs"]
]
