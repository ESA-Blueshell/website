# release-please maintains the changelog, and a contributor editing it would
# otherwise have the change silently dropped by `git add`.
!CHANGELOG.md
!docs/changelogs/*.md
.idea
*dump.sql*

# service env files (*.env and .*.env anywhere under services/)
services/**/.*.env
services/**/*.env

# image build secrets and generated output
/vps/.env
/vps/cloud-init/cloud-config.yaml
/vps/cloud-init/cloud-config-standalone.yaml
/vps/cloud-init/rendered/
/vps/.test-cache/
/vps/packer/output/
/backup/

# infra secrets
/infra/.infra.env

# platform/ is the GitOps tree and must always be fully tracked;
# negate the broad patterns above that would otherwise eat it.
!platform/
!platform/**
# GHCR pull-PAT used during v2 bring-up
.ghcr_token
.cf_token
