# Stage 1: Build base modules
FROM maven:3.9.9-eclipse-temurin-21-alpine AS base-builder
WORKDIR /app

# 1. Copy all POM files
COPY pom.xml .
COPY core-commons/pom.xml ./core-commons/
COPY db-commons/pom.xml ./db-commons/
COPY APIGateway/pom.xml ./APIGateway/
COPY BlogService/pom.xml ./BlogService/
COPY EmailParser/pom.xml ./EmailParser/
COPY EventParser/pom.xml ./EventParser/
COPY SocialMediaService/pom.xml ./SocialMediaService/
COPY Telemetry/pom.xml ./Telemetry/

# 2. Download all dependencies first
RUN --mount=type=cache,target=/root/.m2 \
    mvn -B dependency:go-offline

# 3. Build core modules sequentially
COPY core-commons/src ./core-commons/src
RUN --mount=type=cache,target=/root/.m2 \
    mvn -B install -pl core-commons -DskipTests

COPY db-commons/src ./db-commons/src
RUN --mount=type=cache,target=/root/.m2 \
    mvn -B install -pl db-commons -DskipTests

# Stage 2: Service builder template
FROM maven:3.9.9-eclipse-temurin-21-alpine AS service-builder
WORKDIR /app
ARG SERVICE_NAME

# 1. Reuse source POM structure
COPY --from=base-builder /app .

# 2. Copy service-specific code
COPY ${SERVICE_NAME}/pom.xml ./${SERVICE_NAME}/
COPY ${SERVICE_NAME}/src ./${SERVICE_NAME}/src

# 3. Build with shared cache
RUN --mount=type=cache,target=/root/.m2 \
    mvn -B package -pl ${SERVICE_NAME} -DskipTests
# Final stage: Runtime image
FROM eclipse-temurin:21-alpine
WORKDIR /app
ARG SERVICE_NAME
ENV PORT=${PORT}
COPY --from=service-builder /app/${SERVICE_NAME}/target/*.jar app.jar
EXPOSE ${PORT} 5005
ENTRYPOINT ["java", "-agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=*:5005", "-jar", "app.jar"]