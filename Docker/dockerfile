# Stage 1: Build parent and base modules
FROM maven:3.9.9-eclipse-temurin-21-alpine AS builder
WORKDIR /app

# Copy all POM files first
COPY pom.xml .
COPY core-commons/pom.xml ./core-commons/
COPY db-commons/pom.xml ./db-commons/
COPY BlogService/pom.xml ./BlogService/

# Install parent POM and download dependencies
RUN --mount=type=cache,target=/root/.m2 \
    mvn -B install -N -DskipTests

# Build core-commons
COPY core-commons/src ./core-commons/src
RUN --mount=type=cache,target=/root/.m2 \
    mvn -B install -pl core-commons -am -DskipTests

# Build db-commons
COPY db-commons/src ./db-commons/src
RUN --mount=type=cache,target=/root/.m2 \
    mvn -B install -pl db-commons -am -DskipTests

# Stage 2: Build BlogService
FROM maven:3.9.9-eclipse-temurin-21-alpine AS service-builder
WORKDIR /app
COPY --from=builder /root/.m2 /root/.m2
COPY . .

# Build BlogService with access to cached dependencies
RUN --mount=type=cache,target=/root/.m2 \
    mvn -B package -pl BlogService -am -DskipTests

# Final stage
FROM eclipse-temurin:21-alpine
WORKDIR /app
COPY --from=service-builder /app/BlogService/target/*.jar app.jar
EXPOSE 8080 5005
ENTRYPOINT ["java", "-agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=*:5005", "-jar", "app.jar"]