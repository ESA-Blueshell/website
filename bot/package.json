{
  "name": "discord-member-service",
  "version": "2.0.0",
  "description": "Discord member service with TypeScript, OpenAPI documentation, and clean architecture",
  "main": "dist/app.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/app.js",
    "dev": "ts-node-dev --respawn --transpile-only src/app.ts",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "generate-api-docs": "ts-node src/scripts/generate-openapi.ts",
    "postinstall": "npm run generate-api-docs"
  },
  "keywords": ["discord", "bot", "api", "members", "typescript", "openapi"],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "discord.js": "^14.14.1",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "helmet": "^7.1.0",
    "node-cache": "^5.1.2",
    "swagger-ui-express": "^5.0.0",
    "class-validator": "^0.14.0",
    "class-transformer": "^0.5.1",
    "reflect-metadata": "^0.1.13",
    "inversify": "^6.0.1",
    "express-rate-limit": "^6.10.0",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/node": "^20.5.0",
    "@types/cors": "^2.8.13",
    "@types/swagger-ui-express": "^4.1.3",
    "@types/js-yaml": "^4.0.5",
    "typescript": "^5.1.6",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "nodemon": "^3.0.2",
    "@typescript-eslint/eslint-plugin": "^6.4.1",
    "@typescript-eslint/parser": "^6.4.1",
    "eslint": "^8.47.0",
    "jest": "^29.6.2",
    "@types/jest": "^29.5.4",
    "swagger-jsdoc": "^6.2.8",
    "@types/swagger-jsdoc": "^6.0.1",
    "openapi-types": "^12.1.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}