# =============================================================================
# deployment/.deploy.example.env — environment variables for docker stack deploy.
# Copy to .deploy.env and fill in real values before running `website deploy`.
#
# Source this file in your deploy script before calling docker stack deploy:
#   set -a; source deployment/.deploy.env; set +a
# =============================================================================

# ── Stack identity ────────────────────────────────────────────────────────────
# IMAGE_TAG:  Docker image tag to deploy (latest | staging | dev)
# STACK_NAME: Swarm stack name — also used as Traefik router name prefix
# APP_DOMAIN: Public hostname for this deployment
IMAGE_TAG=latest
STACK_NAME=website
APP_DOMAIN=esa-blueshell.nl

# ── MariaDB ───────────────────────────────────────────────────────────────────
# Generate passwords with: openssl rand -base64 24
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=blueshell
MYSQL_USER=blueshell
MYSQL_PASSWORD=change-me

# ── Spring Boot API ───────────────────────────────────────────────────────────
# Generate JWT secret with: openssl rand -base64 64
JWT_SECRET=replace-with-a-long-random-base64-string

# ── SMTP relay (optional — leave SMTP_HOST blank to disable outbound email) ───
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_SSL=false
SMTP_USE_TLS=true

# ── Brevo (email marketing — optional) ────────────────────────────────────────
BREVO_API_KEY=

# ── Google Calendar (optional) ────────────────────────────────────────────────
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_EMAIL=
GOOGLE_CALENDAR_PRIVATE_KEY_PKCS8=
GOOGLE_CALENDAR_PRIVATE_KEY_ID=

# ── Listmonk ──────────────────────────────────────────────────────────────────
# Generate passwords with: openssl rand -base64 24
LISTMONK_ADMIN_USERNAME=listmonk
LISTMONK_ADMIN_PASSWORD=change-me
LISTMONK_ADMIN_EMAIL=sitecie@blueshell.utwente.nl
LISTMONK_DB_PASSWORD=change-me

# API token user created by listmonk-setup (default: api)
LISTMONK_ADMIN_API_USER=api

# ── Listmonk SMTP (used by Listmonk to send emails) ──────────────────────────
# Can be the same relay as SMTP_* above, or a dedicated transactional sender.
LISTMONK_SMTP_HOST=
LISTMONK_SMTP_PORT=587
LISTMONK_SMTP_USERNAME=
LISTMONK_SMTP_PASSWORD=
LISTMONK_SMTP_AUTH_PROTOCOL=plain
LISTMONK_SMTP_HELLO_HOSTNAME=
LISTMONK_SMTP_TLS_TYPE=starttls
LISTMONK_SMTP_TLS_SKIP_VERIFY=false

# ── Listmonk bounce mailbox (optional — enable to process bounces via IMAP) ───
LISTMONK_BOUNCE_MAILBOX_ENABLED=false
LISTMONK_BOUNCE_MAILBOX_HOST=
LISTMONK_BOUNCE_MAILBOX_PORT=993
LISTMONK_BOUNCE_MAILBOX_USERNAME=
LISTMONK_BOUNCE_MAILBOX_PASSWORD=
LISTMONK_BOUNCE_MAILBOX_TLS_ENABLED=true
LISTMONK_BOUNCE_MAILBOX_TLS_SKIP_VERIFY=false
LISTMONK_BOUNCE_MAILBOX_FOLDER=INBOX
LISTMONK_BOUNCE_MAILBOX_RETURN_PATH=
LISTMONK_BOUNCE_MAILBOX_SCAN_INTERVAL=10m
