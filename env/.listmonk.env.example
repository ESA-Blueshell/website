# Listmonk admin credentials
# Used by the listmonk-setup init container to create the superadmin on first install.
# Changing these after the first install has no effect (credentials are stored in the DB).
LISTMONK_ADMIN_USERNAME=listmonk
LISTMONK_ADMIN_PASSWORD=change_me
LISTMONK_ADMIN_EMAIL=admin@listmonk.local

# API user created during --install (supported in newer Listmonk versions).
# The generated token is written to the listmonk-secrets volume so the api service can use it.
# Set the same value in LISTMONK_ADMIN_API_USER in .api.env.
LISTMONK_ADMIN_API_USER=api

# Listmonk database password (production only)
LISTMONK_DB_PASSWORD=change_me
