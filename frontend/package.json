{
  "name": "blueshell-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit",
    "dev": "vite --host",
    "coverage:system:report": "yarn node ./scripts/convert-frontend-coverage.mjs",
    "coverage:system:merge": "yarn node ./scripts/merge-system-coverage.mjs",
    "lint": "eslint --fix",
    "preview": "tsc && vite preview",
    "gen:discord": "openapi-ts --file ./openapi-ts.discord.config.ts",
    "gen:blueshell": "openapi-ts --file ./openapi-ts.blueshell.config.ts",
    "gen:all": "yarn gen:blueshell && yarn gen:discord",
    "lint:gen": "eslint src/services/api --fix --no-ignore"
  },
  "dependencies": {
    "@hey-api/client-axios": "0.9.1",
    "@mdi/font": "^7.4.47",
    "@vee-validate/rules": "^4.15.1",
    "axios": "^1.13.2",
    "core-js": "^3.47.0",
    "countries-list": "^3.2.0",
    "dompurify": "^3.3.0",
    "flag-icons": "^7.5.0",
    "i18n-nationality": "^1.4.0",
    "ics": "^3.8.1",
    "libphonenumber-js": "^1.12.28",
    "luxon": "^3.7.2",
    "marked": "^17.0.1",
    "node-emoji": "^2.2.0",
    "roboto-fontface": "^0.10.0",
    "v-phone-input": "^5.1.3",
    "vee-validate": "^4.15.1",
    "vue": "3.5.24",
    "vue-axios": "^3.5.2",
    "vue-datepicker-next": "^1.0.3",
    "vue-marquee-text-component": "^2.0.1",
    "vue-router": "^4.6.3",
    "vue-signature-pad": "^3.0.2",
    "vuetify": "^3.10.11",
    "vuex": "^4.1.0",
    "webfontloader": "^1.6.28",
    "world-countries": "^5.1.0",
    "xss": "^1.0.15",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.39.1",
    "@hey-api/openapi-ts": "0.88.0",
    "@originjs/vite-plugin-commonjs": "^1.0.3",
    "@types/luxon": "^3.7.1",
    "@types/node": "^24.10.1",
    "@types/webfontloader": "^1.6.38",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^8.47.0",
    "@vitejs/plugin-vue": "^6.0.2",
    "@vue/tsconfig": "^0.8.1",
    "@vue/typescript-plugin": "^3.1.4",
    "eslint": "^9.39.1",
    "eslint-plugin-vue": "^10.5.1",
    "eslint-plugin-vuetify": "^2.5.3",
    "globals": "^16.5.0",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-reports": "^3.1.7",
    "sass": "^1.94.2",
    "serve": "^14.2.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.47.0",
    "vite": "^7.2.4",
    "vite-plugin-istanbul": "^7.2.1",
    "vite-plugin-vuetify": "^2.1.2",
    "vite-svg-loader": "^5.1.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.1.4"
  },
  "packageManager": "yarn@4.10.3"
}
