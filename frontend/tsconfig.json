{
  "extends": "@vue/tsconfig/tsconfig.json",

  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "lib": ["ESNext", "DOM"],

    "strict": true,
    "skipLibCheck": true,

    "jsx": "preserve",

    "moduleResolution": "Node",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },

    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,

    "types": ["vite/client", "node"]
  },

  "include": [
    "env.d.ts",
    "src/**/*.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "*.config.*"
  ],

  "exclude": ["dist", "node_modules"]
}
