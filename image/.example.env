# =============================================================================
# image/.env — environment variables for building and operating the VM image.
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Primary workflow (cloud-init only, no Packer needed):
#   ./cloud-init/render.sh --standalone   # render cloud-config-standalone.yaml
#   ./ops/create-vps.sh                   # provision VPS on Contabo via cntb
#   ./ops/backup.sh                       # pull a backup from the server
#   ./ops/restore.sh                      # push a backup to the server
#
# Optional: build a pre-baked QEMU image instead (slower, see image/packer/):
#   source .env && packer build packer/image.pkr.hcl
#   ./cloud-init/render.sh                # render cloud-config.yaml (Packer flow)
# =============================================================================

# ── Cloud-init: user passwords ────────────────────────────────────────────────
# Used for console / cloud-portal login only. SSH authentication is keys-only.
BLUESHELL_PASSWORD=change_me   # sudo admin user
ROOT_PASSWORD=change_me        # root account (portal emergency access)
WEBSITE_PASSWORD=change_me     # application service account (no sudo)

# ── Cloud-init: GitHub Container Registry ─────────────────────────────────────
# A GitHub PAT (classic) with only the read:packages scope.
# The website user will be logged into ghcr.io during first boot to pull images.
GHCR_USERNAME=your-github-username
GHCR_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Contabo OAuth2 credentials ────────────────────────────────────────────────
# Obtain from: https://api.contabo.com/#section/Authentication
CLIENT_ID=your-oauth2-client-id
CLIENT_SECRET=your-oauth2-client-secret
CONTABO_API_USER=your-contabo-login-email
CONTABO_API_PASSWORD=your-contabo-login-password

# ── Contabo VPS configuration ──────────────────────────────────────────────────
# Product ID: run 'cntb get products' to list available options
CONTABO_PRODUCT_ID=V22
# Region: EUROPE | US_CENTRAL | US_EAST | US_WEST | ASIA | AUSTRALIA
CONTABO_REGION=EUROPE
# SSH Key ID: integer returned by Contabo after uploading your public key.
# Upload blueshell-admin.pub first (render.sh generates it if absent):
#   cntb create secret --name blueshell-admin \
#     --value "$(cat ~/.ssh/blueshell-admin.pub)" --secretType ssh
# Then run: cntb get secrets --secretType ssh  to find the ID.
CONTABO_SSH_KEY_ID=12345

# ── Ops scripts: production server ────────────────────────────────────────────
# Required by backup.sh and restore.sh. Can also be passed as the first CLI argument.
REMOTE_HOST=           # server IP or hostname (e.g. 1.2.3.4 or myserver.example.com)
SSH_KEY=~/.ssh/blueshell-admin   # path to the admin SSH private key

# ── Packer / QEMU (optional) ──────────────────────────────────────────────────
# Only needed if building a pre-baked image via image/packer/image.pkr.hcl.
# QEMU accelerator: tcg (software emulation, cross-arch/macOS Intel),
#                   hvf (macOS ARM native), kvm (Linux x86_64 hardware)
PKR_VAR_accelerator=tcg
