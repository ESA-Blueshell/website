# =============================================================================
# image/.env — environment variables for provisioning and operating the server.
#
# Copy this file to .env and fill in your values:
#   cp .example.env .env
#
# Workflow:
#   ./cloud-init/render.sh   # render cloud-config-standalone.yaml + env files
#   ./ops/create-vps.sh      # provision VPS on Contabo via cntb
#   ./ops/backup.sh          # pull a backup from the server
#   ./ops/restore.sh         # push a backup to the server
#
# Secrets marked "auto-generated by render.sh if blank" will get a random value
# during render.sh if left empty.  User-provided values (SMTP, API keys, etc.)
# are optional — leave blank to disable the corresponding feature.
# =============================================================================

# ── Cloud-init: user passwords ────────────────────────────────────────────────
# Used for console / cloud-portal login only. SSH authentication is keys-only.
ADMIN_PASSWORD=change_me       # sudo admin user
ROOT_PASSWORD=change_me        # root account (portal emergency access)
WEBSITE_PASSWORD=change_me     # application service account (no sudo)

# ── Cloud-init: GitHub Container Registry ─────────────────────────────────────
# A GitHub PAT (classic) with only the read:packages scope.
# The website user will be logged into ghcr.io during first boot to pull images.
GHCR_USERNAME=your-github-username
GHCR_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Contabo OAuth2 credentials ────────────────────────────────────────────────
# Obtain from: https://api.contabo.com/#section/Authentication
CLIENT_ID=your-oauth2-client-id
CLIENT_SECRET=your-oauth2-client-secret
CONTABO_API_USER=your-contabo-login-email
CONTABO_API_PASSWORD=your-contabo-login-password

# ── Contabo VPS configuration ──────────────────────────────────────────────────
# Product ID: run 'cntb get products' to list available options
CONTABO_PRODUCT_ID=V22
# Region: EUROPE | US_CENTRAL | US_EAST | US_WEST | ASIA | AUSTRALIA
CONTABO_REGION=EUROPE
# SSH Key ID: integer returned by Contabo after uploading your public key.
# Upload blueshell-admin.pub first (render.sh generates it if absent):
#   cntb create secret --name blueshell-admin \
#     --value "$(cat ~/.ssh/blueshell-admin.pub)" --secretType ssh
# Then run: cntb get secrets --secretType ssh  to find the ID.
CONTABO_SSH_KEY_ID=12345

# ── Ops scripts: production server ────────────────────────────────────────────
# Required by backup.sh and restore.sh. Can also be passed as the first CLI argument.
REMOTE_HOST=           # server IP or hostname (e.g. 1.2.3.4 or myserver.example.com)
SSH_KEY=~/.ssh/blueshell-admin   # path to the admin SSH private key

# ── Application database ──────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=          # auto-generated by render.sh if blank
MYSQL_DATABASE=blueshell
MYSQL_USER=blueshell
MYSQL_PASSWORD=               # auto-generated by render.sh if blank

# ── Application secrets ───────────────────────────────────────────────────────
JWT_SECRET=                   # auto-generated by render.sh if blank

# ── SMTP (optional) ──────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_SSL=false
SMTP_USE_TLS=true

# ── Brevo (optional) ─────────────────────────────────────────────────────────
BREVO_API_KEY=

# ── Google Calendar (optional) ────────────────────────────────────────────────
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_SA_JSON=      # base64-encoded service account JSON

# ── Listmonk ─────────────────────────────────────────────────────────────────
LISTMONK_DB_PASSWORD=         # auto-generated by render.sh if blank
LISTMONK_ADMIN_USERNAME=admin
LISTMONK_ADMIN_PASSWORD=      # auto-generated by render.sh if blank
LISTMONK_ADMIN_EMAIL=

# ── Listmonk SMTP (optional) ─────────────────────────────────────────────────
LISTMONK_SMTP_HOST=
LISTMONK_SMTP_PORT=587
LISTMONK_SMTP_USERNAME=
LISTMONK_SMTP_PASSWORD=

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=       # auto-generated by render.sh if blank
GRAFANA_DISCORD_WEBHOOK_URL=

# ── Infisical vault ──────────────────────────────────────────────────────────
INFISICAL_DB_PASSWORD=        # auto-generated by render.sh if blank
INFISICAL_REDIS_PASSWORD=     # auto-generated by render.sh if blank
INFISICAL_ENCRYPTION_KEY=     # auto-generated by render.sh if blank (32 hex chars)
INFISICAL_AUTH_SECRET=        # auto-generated by render.sh if blank

# ── Infisical admin ──────────────────────────────────────────────────────────
INFISICAL_ADMIN_EMAIL=        # admin account for the self-hosted vault
INFISICAL_ADMIN_PASSWORD=     # auto-generated by render.sh if blank

