# =============================================================================
# infra/.infra.env — secrets for the infra Swarm stack (Traefik + monitoring).
# Copy to .infra.env and fill in real values before running `website infra up`.
# =============================================================================

# ── Grafana ───────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
GRAFANA_ADMIN_PASSWORD=change-me

# ── Discord alert notifications (optional — leave blank to disable) ───────────
# Create a webhook in Discord: Server Settings → Integrations → Webhooks
GRAFANA_DISCORD_WEBHOOK_URL=

# ── SMTP for email alerts (optional — leave GRAFANA_SMTP_ENABLED=false to skip)
GRAFANA_SMTP_ENABLED=false
GRAFANA_SMTP_HOST=
GRAFANA_SMTP_USER=
GRAFANA_SMTP_PASSWORD=
GRAFANA_SMTP_FROM=grafana@esa-blueshell.nl
