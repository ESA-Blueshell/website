# =============================================================================
# infra/.infra.env — secrets for the infra Swarm stack (Traefik + monitoring).
# Copy to .infra.env and fill in real values before running `website infra up`.
# =============================================================================

# ── Domain configuration ──────────────────────────────────────────────────────
# Base domain for infra services (grafana.<domain>, status.<domain>).
# Defaults to v2.esa-blueshell.nl if not set.
# render.sh writes BASE_DOMAIN from vps/.env into this file as INFRA_DOMAIN.
INFRA_DOMAIN=v2.esa-blueshell.nl

# Email address registered with Let's Encrypt for certificate expiry notices.
# Defaults to board@blueshell.utwente.nl if not set.
ACME_EMAIL=board@blueshell.utwente.nl

# ── Grafana ───────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
GRAFANA_ADMIN_PASSWORD=change-me

# ── Discord alert notifications (optional — leave blank to disable) ───────────
# Create a webhook in Discord: Server Settings → Integrations → Webhooks
GRAFANA_DISCORD_WEBHOOK_URL=

# ── Alert recipient email ─────────────────────────────────────────────────────
# Email address that receives Grafana alert notifications.
# Defaults to sitecie@blueshell.utwente.nl if not set.
GRAFANA_ALERT_EMAIL=sitecie@blueshell.utwente.nl

# ── SMTP for email alerts (optional — leave GRAFANA_SMTP_ENABLED=false to skip)
GRAFANA_SMTP_ENABLED=false
GRAFANA_SMTP_HOST=
GRAFANA_SMTP_USER=
GRAFANA_SMTP_PASSWORD=
GRAFANA_SMTP_FROM=grafana@v2.esa-blueshell.nl

# ── Infisical vault ────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
INFISICAL_DB_PASSWORD=
# Generate with: openssl rand -base64 32
INFISICAL_REDIS_PASSWORD=
# Generate with: openssl rand -hex 16  (must be exactly 32 hex characters)
INFISICAL_ENCRYPTION_KEY=
# Generate with: openssl rand -base64 32
INFISICAL_AUTH_SECRET=
