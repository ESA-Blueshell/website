{
  "title": "Spring Boot API",
  "uid": "spring-boot-api",
  "tags": ["api", "spring-boot"],
  "timezone": "browser",
  "schemaVersion": 38,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "JVM Heap Used %",
      "type": "gauge",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "targets": [{ "datasource": { "uid": "prometheus" }, "expr": "jvm_memory_used_bytes{area=\"heap\"} / jvm_memory_max_bytes{area=\"heap\"} * 100" }],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "thresholds": { "steps": [{ "value": 0, "color": "green" }, { "value": 70, "color": "yellow" }, { "value": 85, "color": "red" }] } } }
    },
    {
      "id": 2,
      "title": "Active DB Connections",
      "type": "stat",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "targets": [{ "datasource": { "uid": "prometheus" }, "expr": "hikaricp_connections_active", "legendFormat": "active" }],
      "fieldConfig": { "defaults": { "thresholds": { "steps": [{ "value": 0, "color": "green" }, { "value": 8, "color": "yellow" }, { "value": 10, "color": "red" }] } } }
    },
    {
      "id": 3,
      "title": "DB Pool Utilization",
      "type": "stat",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "targets": [{ "datasource": { "uid": "prometheus" }, "expr": "hikaricp_connections_active / hikaricp_connections_max", "legendFormat": "pool %" }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "thresholds": { "steps": [{ "value": 0, "color": "green" }, { "value": 0.7, "color": "yellow" }, { "value": 0.9, "color": "red" }] } } }
    },
    {
      "id": 4,
      "title": "GC Pause Time (rate)",
      "type": "stat",
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
      "targets": [{ "datasource": { "uid": "prometheus" }, "expr": "sum(rate(jvm_gc_pause_seconds_sum[5m]))", "legendFormat": "GC s/s" }],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 5,
      "title": "Log Events by Level (rate)",
      "type": "stat",
      "gridPos": { "x": 16, "y": 0, "w": 4, "h": 4 },
      "targets": [{ "datasource": { "uid": "prometheus" }, "expr": "sum(rate(logback_events_total{level=\"error\"}[5m]))", "legendFormat": "errors/s" }],
      "fieldConfig": { "defaults": { "unit": "cps", "thresholds": { "steps": [{ "value": 0, "color": "green" }, { "value": 0.1, "color": "red" }] } } }
    },
    {
      "id": 6,
      "title": "JVM Memory",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "targets": [
        { "datasource": { "uid": "prometheus" }, "expr": "jvm_memory_used_bytes{area=\"heap\"}", "legendFormat": "Heap Used" },
        { "datasource": { "uid": "prometheus" }, "expr": "jvm_memory_committed_bytes{area=\"heap\"}", "legendFormat": "Heap Committed" },
        { "datasource": { "uid": "prometheus" }, "expr": "jvm_memory_max_bytes{area=\"heap\"}", "legendFormat": "Heap Max" },
        { "datasource": { "uid": "prometheus" }, "expr": "jvm_memory_used_bytes{area=\"nonheap\"}", "legendFormat": "Non-Heap Used" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "id": 7,
      "title": "HikariCP Connection Pool",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "targets": [
        { "datasource": { "uid": "prometheus" }, "expr": "hikaricp_connections_active", "legendFormat": "Active" },
        { "datasource": { "uid": "prometheus" }, "expr": "hikaricp_connections_idle", "legendFormat": "Idle" },
        { "datasource": { "uid": "prometheus" }, "expr": "hikaricp_connections_pending", "legendFormat": "Pending" },
        { "datasource": { "uid": "prometheus" }, "expr": "hikaricp_connections_max", "legendFormat": "Max" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 8,
      "title": "Job Executions",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "targets": [
        { "datasource": { "uid": "prometheus" }, "expr": "rate(job_completed_count_total[5m])", "legendFormat": "completed/s" },
        { "datasource": { "uid": "prometheus" }, "expr": "rate(job_failed_count_total[5m])", "legendFormat": "failed/s" },
        { "datasource": { "uid": "prometheus" }, "expr": "rate(job_dead_count_total[5m])", "legendFormat": "dead/s" }
      ],
      "fieldConfig": { "defaults": { "unit": "cps" } }
    },
    {
      "id": 9,
      "title": "Log Events by Level",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "targets": [
        { "datasource": { "uid": "prometheus" }, "expr": "rate(logback_events_total{level=\"error\"}[1m])", "legendFormat": "ERROR" },
        { "datasource": { "uid": "prometheus" }, "expr": "rate(logback_events_total{level=\"warn\"}[1m])", "legendFormat": "WARN" },
        { "datasource": { "uid": "prometheus" }, "expr": "rate(logback_events_total{level=\"info\"}[1m])", "legendFormat": "INFO" }
      ],
      "fieldConfig": { "defaults": { "unit": "cps" } }
    },
    {
      "id": 10,
      "title": "JVM Threads",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 6 },
      "targets": [
        { "datasource": { "uid": "prometheus" }, "expr": "jvm_threads_live_threads", "legendFormat": "Live" },
        { "datasource": { "uid": "prometheus" }, "expr": "jvm_threads_daemon_threads", "legendFormat": "Daemon" },
        { "datasource": { "uid": "prometheus" }, "expr": "jvm_threads_peak_threads", "legendFormat": "Peak" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 11,
      "title": "GC Pauses",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 20, "w": 12, "h": 6 },
      "targets": [
        { "datasource": { "uid": "prometheus" }, "expr": "sum by (cause) (rate(jvm_gc_pause_seconds_sum[5m]))", "legendFormat": "{{cause}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    }
  ]
}
