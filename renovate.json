{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":dependencyDashboard"
  ],
  "timezone": "Europe/Amsterdam",
  "schedule": [
    "before 06:00 on monday"
  ],
  "minimumReleaseAge": "7 days",
  "labels": [
    "dependencies"
  ],
  "prConcurrentLimit": 8,
  "branchConcurrentLimit": 8,
  "rebaseWhen": "conflicted",
  "ignorePaths": [
    "**/node_modules/**",
    ".claude/**",
    "build/**",
    "**/build/**"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 05:00 on monday"
    ]
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": [
      "dependencies",
      "security"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "The Brevo and Discord clients publish only to GitHub Packages, which needs a registry token Renovate does not have, so a maven lookup returns no-result. Follow the source repositories' release tags instead.",
      "managerFilePatterns": [
        "/^services/api/build\\.gradle\\.kts$/"
      ],
      "matchStrings": [
        "val brevoClientVersion = \"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "github-tags",
      "depNameTemplate": "ESA-Blueshell/brevo-client",
      "depTypeTemplate": "first-party-client",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^services/api/build\\.gradle\\.kts$/"
      ],
      "matchStrings": [
        "val discordClientVersion = \"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "github-tags",
      "depNameTemplate": "ESA-Blueshell/discord-client",
      "depTypeTemplate": "first-party-client",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "@esa-blueshell/discord-client is served by GitHub Packages, which requires a token even though the package is public, so the npm lookup returns no-result. Follow the source repository's release tags instead.",
      "managerFilePatterns": [
        "/^services/frontend/package\\.json$/"
      ],
      "matchStrings": [
        "\"@esa-blueshell/discord-client\":\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "github-tags",
      "depNameTemplate": "ESA-Blueshell/discord-client",
      "depTypeTemplate": "first-party-client",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v(?<version>.+)$"
    }
  ],
  "packageRules": [
    {
      "description": "A major bump needs code changes, so it never joins a group. Dashboard approval keeps it out of the queue until someone picks it up.",
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Frontend minor and patch updates ride in one pull request, the way the Dependabot frontend group did.",
      "matchManagers": [
        "npm"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "frontend dependencies",
      "addLabels": [
        "javascript"
      ]
    },
    {
      "matchManagers": [
        "gradle",
        "gradle-wrapper"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "gradle dependencies",
      "addLabels": [
        "java"
      ]
    },
    {
      "description": "Every action is pinned to a commit digest here, so Renovate keeps the digest and the version comment in step.",
      "matchManagers": [
        "github-actions"
      ],
      "pinDigests": true,
      "groupName": "github actions dependencies",
      "addLabels": [
        "github_actions",
        "ci"
      ]
    },
    {
      "matchManagers": [
        "dockerfile",
        "docker-compose"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "groupName": "container base images",
      "addLabels": [
        "docker"
      ]
    },
    {
      "description": "A cluster chart or controller image reaches production the moment it merges, so each one gets its own reviewed pull request instead of a group.",
      "matchFileNames": [
        "platform/cluster/flux/**"
      ],
      "groupName": null,
      "automerge": false,
      "minimumReleaseAgeBehaviour": "timestamp-optional",
      "addLabels": [
        "area:ci-cd"
      ]
    },
    {
      "description": "gotk-components.yaml is regenerated as a whole by the flux manager. Bumping its controller images through the kubernetes manager would leave Flux half upgraded.",
      "matchManagers": [
        "kubernetes"
      ],
      "matchFileNames": [
        "platform/cluster/flux/clusters/**/flux-system/gotk-components.yaml"
      ],
      "enabled": false
    },
    {
      "description": "The site's own images run on the :latest tag and are rolled by the deploy pipeline, not by a pull request.",
      "matchPackageNames": [
        "/^ghcr\\.io\\/esa-blueshell\\//"
      ],
      "enabled": false
    },
    {
      "description": "net.blueshell.clients resolves only from GitHub Packages, which needs a registry token Renovate does not have. The custom managers above follow the source repositories' tags instead, so the maven lookup is off to keep no-result entries off the dashboard.",
      "matchDatasources": [
        "maven"
      ],
      "matchPackageNames": [
        "/^net\\.blueshell\\.clients[.:]/"
      ],
      "enabled": false
    },
    {
      "description": "@esa-blueshell packages are covered by the custom managers above.",
      "matchDatasources": [
        "npm"
      ],
      "matchPackageNames": [
        "/^@esa-blueshell\\//"
      ],
      "enabled": false
    },
    {
      "matchDepTypes": [
        "first-party-client"
      ],
      "groupName": "blueshell generated clients"
    }
  ]
}
