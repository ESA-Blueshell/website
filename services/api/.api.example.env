# =============================================================================
# services/api/.api.env — application secrets for the Spring Boot API.
# Copy to .api.env and fill in real values before deploying.
# =============================================================================

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
# Must stay Base64-encoded; production rejects hex strings here.
JWT_SECRET=replace-with-a-long-random-base64-string

# ── Storage ───────────────────────────────────────────────────────────────────
STORAGE_LOCATION=/home/storage

# ── Outbound mail ─────────────────────────────────────────────────────────────
# SMTP relay (optional — leave SMTP_HOST blank to disable outbound email).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_USE_SSL=false

# Default From: / Reply-To: applied to every transactional email.
EMAIL_FROM_ADDRESS=no-reply@esa-blueshell.nl
EMAIL_FROM_NAME=Blueshell Esports
EMAIL_REPLY_TO_ADDRESS=sitecie@blueshell.utwente.nl

# Inbound bounce processing via IMAP (optional — disabled by default).
EMAIL_BOUNCE_IMAP_ENABLED=false
EMAIL_BOUNCE_IMAP_HOST=
EMAIL_BOUNCE_IMAP_PORT=993
EMAIL_BOUNCE_IMAP_USERNAME=
EMAIL_BOUNCE_IMAP_PASSWORD=
EMAIL_BOUNCE_IMAP_FOLDER=INBOX
EMAIL_BOUNCE_IMAP_TLS=true
EMAIL_BOUNCE_POLL_INTERVAL_MS=300000

# ── Brevo (email marketing — optional) ────────────────────────────────────────
BREVO_API_KEY=
BREVO_FOLDER_CONTRIBUTION_PERIODS_ID=

# ── Payments (optional) ───────────────────────────────────────────────────────
MOLLIE_API_KEY=

# ── Google Calendar (optional) ────────────────────────────────────────────────
# GOOGLE_CALENDAR_ID: the calendar ID from Google Calendar settings
# GOOGLE_CALENDAR_SA_JSON: full contents of the service account JSON key file
#   Download from: Google Cloud Console → IAM → Service Accounts → Keys → Add Key → JSON
#   Store as single-line JSON (escape newlines) or use: $(cat sa.json | tr -d '\n')
#   The Vault seeding script also accepts the legacy split GOOGLE_CALENDAR_* fields
#   and reconstructs this value automatically.
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_SA_JSON=

# ── Social integrations (optional) ────────────────────────────────────────────
FACEBOOK_PAGE_ID=
FACEBOOK_ACCESS_TOKEN=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# ── Vault / OIDC ──────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
VAULT_OIDC_CLIENT_SECRET=
