# =============================================================================
# services/api/.db.env — MariaDB credentials.
# Copy to .db.env and fill in real values before deploying.
# =============================================================================

# Generate strong passwords with: openssl rand -base64 32
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=blueshell
MYSQL_USER=blueshell
MYSQL_PASSWORD=change-me

# Optional override for the Vault database secrets engine bootstrap.
# If left blank, the seeding script reuses root/root-password.
MARIADB_ADMIN_USER=root
MARIADB_ADMIN_PASSWORD=
