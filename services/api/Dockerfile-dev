# syntax=docker/dockerfile:1.7
FROM eclipse-temurin:21-jdk

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Where Playwright stores browsers
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

COPY api/ .
COPY shared/openapi/ /shared/openapi/
COPY listmonk/openapi.yaml /listmonk/openapi.yaml

RUN chmod +x gradlew

# Download Gradle distribution into the image layer so it is available at
# runtime even when the gradle-cache volume starts empty (e.g. after down -v).
RUN ./gradlew --no-daemon --version

# Build app (only dependency caches go into the BuildKit cache mount)
RUN --mount=type=cache,target=/root/.gradle/caches \
    ./gradlew --no-daemon assemble -x test

# Install Playwright OS deps + Chromium during build
RUN --mount=type=cache,target=/root/.gradle/caches \
    --mount=type=cache,target=/ms-playwright \
    ./gradlew --no-daemon installChromium -x test

EXPOSE ${PORT} 5005

CMD ["sh", "-c", "./gradlew --no-daemon bootRun -Dspring-boot.run.profiles=dev -Dspring-boot.run.fork=false"]
