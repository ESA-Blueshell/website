FROM node:25.6.1-bookworm-slim@sha256:34d76bac75fba8eea764d3b79b05be7a77fa0651d7b956b011b4a55837fdbc02

WORKDIR /usr/app

# Node 25+ no longer bundles Corepack (the nodejs TSC dropped it from the
# official distributions), so install it explicitly before enabling.
RUN npm install -g --force corepack@latest && corepack enable
ENV CHOKIDAR_USEPOLLING=1
ENV WATCHPACK_POLLING=true
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

# Copy only what's needed for dependency install
COPY package.json yarn.lock .yarnrc.yml ./

RUN corepack install && yarn install --immutable

# Install Playwright browser + required OS packages at image build time.
RUN mkdir -p /ms-playwright \
 && yarn playwright install --with-deps chromium

# App/config files
COPY . .

EXPOSE 3000
CMD ["yarn", "dev", "--host"]
