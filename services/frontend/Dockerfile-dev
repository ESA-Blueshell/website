# syntax=docker/dockerfile:1.27

FROM node:26.10.0-bookworm-slim@sha256:3ffc19ea878019d9e9ae8971732ad4a03cda44f167107173174b60ed7c65bed3

WORKDIR /usr/app

RUN npm install -g --force corepack@latest && corepack enable
ENV CHOKIDAR_USEPOLLING=1
ENV WATCHPACK_POLLING=true
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

COPY package.json yarn.lock .yarnrc.yml ./

RUN corepack install \
 && yarn install --immutable

RUN mkdir -p /ms-playwright \
 && yarn playwright install --with-deps chromium

COPY scripts/dev-entrypoint.sh /usr/local/bin/dev-entrypoint.sh

COPY . .

EXPOSE 3000
ENTRYPOINT ["/usr/local/bin/dev-entrypoint.sh"]
CMD ["yarn", "dev", "--host"]
