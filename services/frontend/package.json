{
  "name": "blueshell-frontend",
  "version": "1.7.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.typecheck.json",
    "dev": "vite --host",
    "test:unit": "vitest run --coverage",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "yarn test:unit",
    "test:e2e": "yarn node ./scripts/run-e2e-with-coverage.mjs",
    "test:e2e:headed": "yarn test:e2e --headed",
    "test": "yarn test:unit && yarn test:e2e",
    "coverage:system:report": "yarn node ./scripts/convert-frontend-coverage.mjs",
    "lint": "eslint --fix --max-warnings 0 src tests scripts vite.config.mjs vitest.config.ts playwright.config.ts eslint.config.mjs",
    "preview": "tsc && vite preview",
    "gen:blueshell": "openapi-ts --file ./openapi-ts.blueshell.config.ts",
    "gen:all": "yarn gen:blueshell",
    "lint:gen": "eslint src/services/api --fix --no-ignore"
  },
  "dependencies": {
    "@esa-blueshell/discord-client": "1.1.1",
    "@hey-api/client-axios": "0.9.1",
    "@mdi/font": "^7.4.47",
    "@tailwindcss/vite": "^4.3.3",
    "@vee-validate/rules": "^4.15.1",
    "@vueuse/core": "^14.4.0",
    "axios": "^1.19.0",
    "core-js": "^3.50.0",
    "countries-list": "^3.4.0",
    "dompurify": "^3.4.14",
    "flag-icons": "^7.5.0",
    "i18n-nationality": "^1.4.0",
    "ics": "^3.12.0",
    "libphonenumber-js": "^1.13.11",
    "luxon": "^3.7.2",
    "marked": "^18.0.10",
    "motion-v": "^2.4.0",
    "node-emoji": "^2.2.0",
    "reka-ui": "^2.10.4",
    "roboto-fontface": "^0.10.0",
    "tailwindcss": "^4.3.3",
    "v-phone-input": "^7.0.0",
    "vee-validate": "^4.15.1",
    "vue": "3.5.41",
    "vue-axios": "^3.5.2",
    "vue-datepicker-next": "^1.0.3",
    "vue-marquee-text-component": "^2.0.1",
    "vue-router": "^5.2.0",
    "vue-signature-pad": "^3.0.2",
    "vuetify": "^4.1.9",
    "vuex": "^4.1.0",
    "webfontloader": "^1.6.28",
    "world-countries": "^5.1.0",
    "xss": "^1.0.15",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@hey-api/openapi-ts": "0.99.0",
    "@originjs/vite-plugin-commonjs": "^1.0.3",
    "@playwright/test": "1.63.0",
    "@types/luxon": "^3.7.5",
    "@types/node": "^26.2.0",
    "@types/webfontloader": "^1.6.38",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-istanbul": "4.1.11",
    "@vue/compiler-dom": "3.5.41",
    "@vue/server-renderer": "3.5.41",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "@vue/typescript-plugin": "^3.3.11",
    "eslint": "^10.9.0",
    "eslint-plugin-vue": "^10.10.0",
    "eslint-plugin-vuetify": "^2.7.2",
    "fast-xml-parser": "^5.11.0",
    "globals": "^17.11.0",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-reports": "^3.2.0",
    "jsdom": "^30.0.1",
    "sass": "^1.103.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vite-plugin-istanbul": "^9.0.1",
    "vite-plugin-vuetify": "^2.1.3",
    "vite-svg-loader": "^5.1.1",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  },
  "packageManager": "yarn@4.10.3",
  "resolutions": {
    "esbuild@^0.14.14": "0.28.1",
    "js-yaml@4.2.0": "4.3.1",
    "minimatch@9.0.1": "9.0.7",
    "minimatch@^9.0.4": "9.0.7"
  }
}
