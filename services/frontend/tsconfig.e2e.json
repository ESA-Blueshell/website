{
  "extends": "./tsconfig.typecheck.json",
  "compilerOptions": {
    "types": ["node"],
    // A spec reads the frames, boxes and rows it just asserted exist; the check is for the
    // mocks' records against the api's types, not for every index of every measurement.
    "noUncheckedIndexedAccess": false
  },
  "include": [
    "env.d.ts",
    "src/**/*.d.ts",
    "tests/e2e/**/*.ts"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
