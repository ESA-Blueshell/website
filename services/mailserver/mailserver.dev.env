# Dev environment overrides — loaded on top of mailserver.env
# Disables features that require external DNS (DKIM/DMARC/SPF) and
# enables a self-signed TLS cert so Listmonk's IMAP bounce poller can
# connect with tls_skip_verify=true.

SSL_TYPE=self-signed

# Allow any container on connected Docker networks to relay without auth.
# Safe for local dev; never use in production.
PERMIT_DOCKER=connected-networks

# Disable DNS-dependent features (no MX/SPF/DKIM records in dev)
ENABLE_OPENDKIM=0
ENABLE_OPENDMARC=0
ENABLE_POLICYD_SPF=0

# Disable Amavis content filter (faster startup, no ClamAV needed)
ENABLE_AMAVIS=0

# IPv4 only avoids slow IPv6 lookups in Docker
POSTFIX_INET_PROTOCOLS=ipv4
DOVECOT_INET_PROTOCOLS=ipv4

# Silence noisy update-check pings in dev
ENABLE_UPDATE_CHECK=0

# Override hostname so DMS doesn't rely on DNS resolution for the FQDN
OVERRIDE_HOSTNAME=mail.dev.local
