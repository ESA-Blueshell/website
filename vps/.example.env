# =============================================================================
# vps/.env — environment variables for provisioning and operating the server.
#
# Copy this file to .env and fill in your values:
#   cp .example.env .env
#
# Workflow:
#   ./cloud-init/render.sh            # render cloud-config.yaml + env files
#   ./scripts/local/reinstall.sh      # reinstall existing VPS image via cntb
#   ./scripts/local/backup.sh         # pull a backup from the server
#   ./scripts/local/restore.sh        # push a backup to the server
#
# Secrets marked "auto-generated by render.sh if blank" are listed at the bottom.
# Optional integration keys (SMTP, Brevo, etc.) are also listed there.
# =============================================================================

# ── Cloud-init: user passwords ────────────────────────────────────────────────
# Used for console / cloud-portal login only. SSH authentication is keys-only.
ADMIN_PASSWORD=change_me       # sudo admin user
ROOT_PASSWORD=change_me        # root account (portal emergency access)
WEBSITE_PASSWORD=change_me     # application service account (no sudo)

# ── Cloud-init: GitHub Container Registry ─────────────────────────────────────
# A GitHub PAT (classic) with only the read:packages scope.
# The website user will be logged into ghcr.io during first boot to pull images.
GHCR_USERNAME=your-github-username
GHCR_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Domain ────────────────────────────────────────────────────────────────────
# Base domain for the entire deployment.
BASE_DOMAIN=v2.esa-blueshell.nl

# ── Contabo OAuth2 credentials ────────────────────────────────────────────────
# Obtain from: https://api.contabo.com/#section/Authentication
CLIENT_ID=your-oauth2-client-id
CLIENT_SECRET=your-oauth2-client-secret
CONTABO_API_USER=your-contabo-login-email
CONTABO_API_PASSWORD=your-contabo-login-password

# ── Contabo VPS configuration ────────────────────────────────────────────────
# Instance ID: numeric objectId of the existing VPS (run: cntb get instances)
CONTABO_INSTANCE_ID=203162642
# SSH Key ID: integer returned by Contabo after uploading your public key.
# Upload blueshell-admin.pub first (render.sh generates it if absent):
#   cntb create secret --name blueshell-admin \
#     --value "$(cat ~/.ssh/blueshell-admin.pub)" --type ssh
# Then run: cntb get secrets --type ssh  to find the ID.
CONTABO_SSH_KEY_ID=12345

# ── TransIP DNS-01 ACME challenge ─────────────────────────────────────────────
# Required for Let's Encrypt wildcard TLS certificates.
# 1. Log in at https://www.transip.nl/cp/account/api/ and generate a key pair.
# 2. Save the private key PEM to a file on your local machine.
# 3. Set the values below.
TRANSIP_ACCOUNT_NAME=your-transip-login
TRANSIP_PRIVATE_KEY_FILE=/path/to/transip_key.pem

# ── Ops scripts: production server ──────────────────────────────────────────
# Required by backup.sh and restore.sh.
REMOTE_HOST=           # server IP or hostname
SSH_KEY=~/.ssh/blueshell-admin

# ── Auto-generated secrets (render.sh fills these if left blank) ──────────────
# MYSQL_ROOT_PASSWORD, MYSQL_PASSWORD, JWT_SECRET,
# LISTMONK_DB_PASSWORD, LISTMONK_ADMIN_PASSWORD,
# GRAFANA_ADMIN_PASSWORD, INFISICAL_DB_PASSWORD, INFISICAL_REDIS_PASSWORD,
# INFISICAL_ENCRYPTION_KEY, INFISICAL_AUTH_SECRET, INFISICAL_ADMIN_PASSWORD
#
# ── Optional integrations (leave blank or omit to disable) ────────────────────
# MYSQL_DATABASE, MYSQL_USER, SMTP_HOST, SMTP_PORT, SMTP_USERNAME,
# SMTP_PASSWORD, SMTP_USE_SSL, SMTP_USE_TLS, BREVO_API_KEY,
# GOOGLE_CALENDAR_ID, GOOGLE_CALENDAR_SA_JSON,
# LISTMONK_ADMIN_USERNAME, LISTMONK_ADMIN_EMAIL,
# LISTMONK_SMTP_HOST, LISTMONK_SMTP_PORT, LISTMONK_SMTP_USERNAME,
# LISTMONK_SMTP_PASSWORD, GRAFANA_DISCORD_WEBHOOK_URL,
# INFISICAL_ADMIN_EMAIL
#
# See lib/credentials.py for the full list with defaults.
